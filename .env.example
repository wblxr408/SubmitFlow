# ============================================================
# SubmitFlow 环境变量配置
# 复制此文件为 .env.local 并填入实际值
# Windows: copy .env.example .env.local
# ============================================================

# 数据库连接（必填）
# Windows 本地开发推荐：
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/submitflow

# ============================================================
# 加密密钥（必填，32字节hex编码，64字符）
# Windows PowerShell 生成命令：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================
ENCRYPTION_KEY=

# ============================================================
# JWT 认证配置（v1.3 新增）
# ============================================================
# JWT 密钥（建议32位以上，如不填则使用 ENCRYPTION_KEY 前32位）
# Windows PowerShell 生成命令：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# JWT 过期时间（默认 7d，支持 1h, 7d, 30d 等）
JWT_EXPIRES_IN=7d

# ============================================================
# SMTP 邮件配置（可选，用于发送验证邮件、密码重置等）
# Gmail 示例：
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=需要使用 Gmail 应用专用密码，不是登录密码！
# ============================================================
SMTP_HOST=

# ============================================================
# 默认管理员配置（v1.3 新增，首次迁移时使用）
# 如果已有用户数据则不会创建
# ============================================================
DEFAULT_ADMIN_EMAIL=admin@submitflow.local
DEFAULT_ADMIN_PASSWORD=admin123

# ============================================================
# AI 服务商配置（可选）
# ============================================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 智谱 AI
ZHIPU_API_KEY=your-zhipu-key

# 阿里通义
QWEN_API_KEY=your-qwen-key

# MiniMax
MINIMAX_API_KEY=your-minimax-key

# 月之暗面 (Kimi)
MOONSHOT_API_KEY=your-moonshot-key

# ============================================================
# Gmail OAuth（可选，用于邮件同步）
# ============================================================
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret

# ============================================================
# 应用配置
# ============================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3208

# ============================================================
# Windows 开发环境说明
# ============================================================
# 1. 确保已安装 Node.js 20+
# 2. 确保已安装 PostgreSQL 16（或使用 Docker）
# 3. 创建 .env.local 文件（复制本文件）
# 4. 填写 DATABASE_URL 和 ENCRYPTION_KEY（必填）
# 5. 运行 npm install
# 6. 运行 npm run db:migrate
# 7. 运行 npm run dev
# 8. 访问 http://localhost:3208
